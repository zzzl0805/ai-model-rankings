.about-page {
  height: 100%;
  background-color: #FFFFFF;
}

.container {
  padding: 40rpx 32rpx 80rpx;
}

/* -- Hero -- */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 40rpx;
}

.hero-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}

.hero-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 8rpx;
}

.hero-version {
  font-size: 26rpx;
  color: #66707C;
  background-color: #F1F5F9;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}

/* -- Section -- */
.section {
  margin-bottom: 36rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 16rpx;
}

.section-body {
  display: block;
  font-size: 28rpx;
  color: #334155;
  line-height: 1.8;
}

/* -- Features -- */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 20rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
}

.feature-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  line-height: 1;
}

.feature-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F172A;
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #5B6675;
  line-height: 1.5;
}

/* -- Links -- */
.link-list {
  background-color: #F5F7FA;
  border-radius: 12rpx;
  overflow: hidden;
}

.link-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #E4E8EE;
}

.link-item:last-child {
  border-bottom: none;
}

.link-text {
  font-size: 28rpx;
  color: #0F172A;
}

.link-arrow {
  font-size: 32rpx;
  color: #66707C;
}

/* -- Contact -- */
.contact-card {
  padding: 24rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
}

.contact-line {
  display: block;
  font-size: 26rpx;
  color: #334155;
  line-height: 2;
}

.contact-email {
  color: #0F5EF0;
}

/* -- Copyright -- */
.copyright {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #E4E8EE;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.copyright-text {
  font-size: 22rpx;
  color: #66707C;
}

/* ================= v1.6 ================= */

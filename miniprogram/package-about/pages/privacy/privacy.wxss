.privacy-page {
  height: 100%;
  background-color: #FFFFFF;
}

.container {
  padding: 32rpx 32rpx 80rpx;
}

/* -- Page Header -- */
.page-header {
  margin-bottom: 36rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 8rpx;
}

.page-date {
  font-size: 24rpx;
  color: #66707C;
}

/* -- Section -- */
.section {
  margin-bottom: 36rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 16rpx;
}

.section-body {
  display: block;
  font-size: 28rpx;
  color: #334155;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

/* -- Contact card -- */
.contact-card {
  margin-top: 12rpx;
  padding: 24rpx;
  background-color: #F6F7F9;
  border-radius: 12rpx;
}

.contact-line {
  font-size: 26rpx;
  color: #0F5EF0;
  line-height: 1.8;
}

/* -- Footer -- */
.footer-section {
  padding-top: 32rpx;
  border-top: 1rpx solid #E4E8EE;
}

.footnote {
  font-size: 26rpx;
  color: #66707C;
}

/* ================= v1.6 ================= */
page { background: #F6F7F9; font-size: 15px; }
.privacy-page { background: #F6F7F9; }
.container { padding: 32rpx 28rpx 64rpx; }
.page-title { font-size: 24px; font-weight: 600; color: #0F172A; }
.page-date { font-size: 12px; color: #5B6675; }
.section-title { font-size: 17px; color: #0F172A; }
.section-body { font-size: 15px; line-height: 1.75; color: #334155; }
.contact-card { background: #FFFFFF; border: 1rpx solid #E4E8EE; border-radius: 12rpx; padding: 20rpx; }
.contact-line { font-size: 14px; color: #334155; }
.footnote { font-size: 13px; color: #5B6675; }

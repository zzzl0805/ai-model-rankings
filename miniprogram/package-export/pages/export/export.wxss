.export-page {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F5F7FA;
}

.stub-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.stub-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}

.stub-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 12rpx;
}

.stub-desc {
  font-size: 28rpx;
  color: #66707C;
  margin-bottom: 48rpx;
}

.stub-btn {
  padding: 20rpx 80rpx;
  background-color: #0F172A;
  border-radius: 12rpx;
}

.stub-btn-text {
  font-size: 30rpx;
  color: #FFFFFF;
}

/* ================= v1.6 ================= */
page { background: #F5F7FA; }
.export-page { background: #F5F7FA; }
.stub-title { font-size: 20px; font-weight: 600; color: #0F172A; }
.stub-desc { font-size: 13px; color: #5B6675; }
.stub-btn { border-radius: 10rpx; background: #0F172A; }
.stub-btn-text { font-size: 14px; }

.export-page {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F8FAFC;
}

.stub-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.stub-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}

.stub-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.stub-desc {
  font-size: 28rpx;
  color: #94A3B8;
  margin-bottom: 48rpx;
}

.stub-btn {
  padding: 20rpx 80rpx;
  background-color: #0F5EF0;
  border-radius: 12rpx;
}

.stub-btn-text {
  font-size: 30rpx;
  color: #FFFFFF;
}

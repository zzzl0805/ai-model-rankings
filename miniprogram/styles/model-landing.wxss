/* styles/model-landing.wxss */
page { background: #F8FAFC; }
.page { min-height: 100vh; padding-bottom: 60rpx; }

.hero { background: linear-gradient(135deg, #1A1A2E, #16213E, #0F5EF0); padding: 40rpx 32rpx 36rpx; color: #FFFFFF; }
.hero-kicker { display: block; font-size: 22rpx; opacity: 0.62; margin-bottom: 14rpx; }
.hero-title { display: block; font-size: 46rpx; font-weight: 700; line-height: 1.25; }
.hero-sub { display: block; margin-top: 12rpx; font-size: 25rpx; opacity: 0.78; }
.hero-desc { display: block; margin-top: 18rpx; font-size: 23rpx; line-height: 1.7; opacity: 0.82; }

.body { padding-top: 4rpx; }
.card { background: #FFFFFF; margin: 20rpx 24rpx; border-radius: 18rpx; padding: 26rpx 28rpx; box-shadow: 0 2rpx 10rpx rgba(15,23,42,0.04); }
.card-title { display: block; font-size: 28rpx; font-weight: 700; color: #0F172A; margin-bottom: 16rpx; }
.card-note { display: block; font-size: 20rpx; color: #94A3B8; margin: -6rpx 0 12rpx; line-height: 1.5; }
.text { display: block; font-size: 26rpx; color: #334155; line-height: 1.7; }

.stat-grid { display: flex; flex-wrap: wrap; }
.stat { width: 50%; box-sizing: border-box; padding: 10rpx 12rpx 10rpx 0; }
.stat-label { display: block; font-size: 20rpx; color: #94A3B8; }
.stat-value { display: block; margin-top: 4rpx; font-size: 26rpx; font-weight: 600; color: #0F172A; word-break: break-all; }

.chips { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.chip { margin: 0 12rpx 10rpx 0; padding: 6rpx 16rpx; font-size: 21rpx; color: #0F5EF0; background: #EFF6FF; border-radius: 18rpx; }

.rank-row { display: flex; align-items: center; padding: 12rpx 0; }
.rank-name { width: 150rpx; font-size: 22rpx; color: #334155; }
.rank-bar-bg { flex: 1; height: 12rpx; margin: 0 16rpx; background: #E2E8F0; border-radius: 6rpx; overflow: hidden; }
.rank-bar-fill { height: 100%; background: linear-gradient(90deg, #0F5EF0, #7C3AED); border-radius: 6rpx; }
.rank-value { width: 110rpx; text-align: right; font-size: 25rpx; font-weight: 700; color: #0F172A; }
.rank-total { font-size: 18rpx; font-weight: 400; color: #94A3B8; }

.spec-grid { display: flex; flex-wrap: wrap; }
.spec { width: 50%; box-sizing: border-box; padding: 10rpx 12rpx 10rpx 0; }
.spec-label { display: block; font-size: 20rpx; color: #94A3B8; }
.spec-value { display: block; margin-top: 4rpx; font-size: 24rpx; color: #1E293B; word-break: break-all; }

.link-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-top: 1rpx solid #F1F5F9; }
.link-main { flex: 1; font-size: 24rpx; color: #1E293B; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.link-meta { margin-left: 16rpx; font-size: 19rpx; color: #94A3B8; flex-shrink: 0; }

.cta-row { display: flex; flex-wrap: wrap; margin: 24rpx 24rpx 0; }
.cta { flex: 1; min-width: 300rpx; padding: 22rpx 0; text-align: center; background: #0F5EF0; color: #FFFFFF; border-radius: 16rpx; font-size: 27rpx; font-weight: 600; }
.cta-sec { margin-left: 16rpx; padding: 22rpx 26rpx; text-align: center; background: #FFFFFF; color: #0F5EF0; border: 1rpx solid #E2E8F0; border-radius: 16rpx; font-size: 25rpx; }

.source { margin: 26rpx 32rpx 0; text-align: center; font-size: 20rpx; color: #94A3B8; line-height: 1.8; }
.source text { display: block; }

/* styles/board-page.wxss — 榜单落地页共用样式 */
page { background: #F8FAFC; }

.hero { padding: 40rpx 32rpx 36rpx; background: linear-gradient(135deg, #1A1A2E, #16213E, #0F5EF0); color: #FFFFFF; }
.hero-title { display: block; font-size: 44rpx; font-weight: 700; }
.hero-sub { display: block; margin-top: 12rpx; font-size: 24rpx; opacity: 0.75; }
.hero-desc { display: block; margin-top: 20rpx; font-size: 24rpx; line-height: 1.7; opacity: 0.85; }

.more-link { margin: 28rpx 24rpx 0; padding: 24rpx 0; text-align: center; font-size: 26rpx; color: #0F5EF0; font-weight: 600; background: #FFFFFF; border-radius: 16rpx; }
.more-link:active { background: #F1F5F9; }

.page-foot { margin: 24rpx 32rpx 48rpx; text-align: center; font-size: 20rpx; color: #94A3B8; }

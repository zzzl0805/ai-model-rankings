/* pages/admin/admin.wxss */
.page { background: #F8FAFC; min-height: 100vh; padding-bottom: 40rpx; }
.header { background: #1E293B; padding: 40rpx 32rpx; }
.title { font-size: 36rpx; font-weight: 700; color: #fff; }
.card { background: #fff; margin: 20rpx 24rpx; border-radius: 16rpx; padding: 28rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.card-title { font-size: 30rpx; font-weight: 700; color: #1E293B; margin-bottom: 16rpx; display: block; }
.info-row { display: flex; justify-content: space-between; padding: 8rpx 0; }
.info-val { font-weight: 600; color: #0F5EF0; }
.desc { font-size: 24rpx; color: #64748B; line-height: 1.5; display: block; margin-bottom: 20rpx; }
.upload-btn { height: 88rpx; background: #0F5EF0; border-radius: 44rpx; color: #fff; font-size: 30rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
.upload-btn.disabled { background: #94A3B8; }
.result { display: block; text-align: center; margin-top: 16rpx; font-size: 28rpx; }
.tips { padding: 24rpx; }
.tips-title { font-size: 26rpx; font-weight: 600; color: #64748B; display: block; margin-bottom: 8rpx; }
.tips-text { font-size: 22rpx; color: #94A3B8; display: block; line-height: 1.8; }

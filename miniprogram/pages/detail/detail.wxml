<!-- pages/detail/detail.wxml — v1.7 品牌蓝专业版 -->
<view class="page">
  <view wx:if="{{loading}}" class="center-box"><text>加载中…</text></view>
  <view wx:elif="{{!modelName}}" class="center-box">
    <text>未找到该模型</text>
    <view class="back-btn" bindtap="goBack">返回</view>
  </view>

  <block wx:else>
    <!-- Hero：身份 -->
    <view class="hero">
      <text class="hero-kicker">{{provider}}<text wx:if="{{familyName}}"> · {{familyName}}</text></text>
      <text class="hero-title">{{displayName}}</text>
      <text class="hero-meta">
        <text wx:if="{{variantLabel}}">{{variantLabel}} · </text>
        <text wx:if="{{statusText}}">{{statusText}} · </text>
        <text wx:if="{{openWeightsText}}">{{openWeightsText}} · </text>
        <text>{{confidence.label}}</text>
      </text>
      <text wx:if="{{archivePending}}" class="hero-pending">档案建设中，以下为可确认的榜单与价格信息</text>
    </view>

    <!-- 核心数据 -->
    <view class="card metrics-card">
      <view class="metric">
        <text class="metric-label">{{scoreLabel}}</text>
        <text class="metric-value">{{primaryElo}}</text>
      </view>
      <view class="metric">
        <text class="metric-label">主榜</text>
        <text class="metric-value">#{{primaryRank}}<text class="metric-sub">/{{primaryTotal}}</text></text>
      </view>
      <view class="metric">
        <text class="metric-label">价格</text>
        <text wx:if="{{priceView.has}}" class="metric-value">{{priceView.inputText}}<text class="metric-sub">{{priceView.unitSuffix}}</text></text>
        <text wx:else class="metric-value metric-none">—</text>
      </view>
      <view class="metric">
        <text class="metric-label">上下文</text>
        <text class="metric-value">{{contextText}}</text>
      </view>
    </view>
    <text wx:if="{{priceView.has}}" class="price-note">输入 {{priceView.inputText}}{{priceView.unitSuffix}} · 输出 {{priceView.outputText}}{{priceView.unitSuffix}}</text>
    <text wx:if="{{priceView.has}}" class="price-note">来源：{{priceView.source}}{{priceView.isProxy ? '（代理）' : ''}} · {{priceView.asOf}}</text>
    <text wx:if="{{priceView.alt}}" class="price-note">OpenRouter 参考价 {{priceView.alt.inputText}} / {{priceView.alt.outputText}}</text>

    <!-- 定位 -->
    <view class="card">
      <text class="card-title">定位</text>
      <text class="body">{{summary}}</text>
      <text wx:if="{{bestFor.length}}" class="body-meta">
        适用：<text wx:for="{{bestFor}}" wx:key="*this">{{item}}{{index < bestFor.length - 1 ? ' · ' : ''}}</text>
      </text>
    </view>

    <!-- 关键规格 -->
    <view wx:if="{{hasSpecs}}" class="card">
      <text class="card-title">关键规格</text>
      <view class="spec-row"><text class="spec-label">上下文</text><text class="spec-value">{{contextText}}</text></view>
      <view class="spec-row"><text class="spec-label">最大输出</text><text class="spec-value">{{maxOutputText}}</text></view>
      <view class="spec-row"><text class="spec-label">输入</text><text class="spec-value">{{inputModsText}}</text></view>
      <view class="spec-row"><text class="spec-label">输出</text><text class="spec-value">{{outputModsText}}</text></view>
      <view class="spec-row"><text class="spec-label">发布</text><text class="spec-value">{{releaseDateText}}</text></view>
      <view class="spec-row"><text class="spec-label">许可证</text><text class="spec-value">{{licenseText}}</text></view>
      <view class="spec-row"><text class="spec-label">知识截止</text><text class="spec-value">{{knowledgeCutoff}}</text></view>
      <view class="spec-row"><text class="spec-label">API ID</text><text class="spec-value spec-mono">{{apiModelId ? apiModelId : '—'}}</text></view>
      <text wx:if="{{specNote}}" class="section-note">{{specNote}}</text>
      <text wx:if="{{docsUrl}}" class="text-link" bindtap="copyDocs">复制官方文档链接</text>
    </view>

    <!-- 榜单表现 -->
    <view wx:if="{{categoryRanks.length}}" class="card">
      <text class="card-title">榜单表现</text>
      <view wx:for="{{categoryRanks}}" wx:key="id" class="rank-row">
        <text class="rank-name">{{item.name}}</text>
        <text class="rank-pos">#{{item.rank}}<text class="rank-total">/{{item.total}}</text></text>
        <text class="rank-pct">前 {{item.topPct}}%</text>
      </view>
      <text class="section-note">类目内排名；不同类目的 Elo 尺度不可直接比较</text>
    </view>

    <!-- 分维度 -->
    <view wx:if="{{dimensions.length > 1}}" class="card">
      <text class="card-title">{{primaryIsAgent ? '分维度净提升率' : '分维度 Elo'}}</text>
      <view wx:for="{{dimensions}}" wx:key="id" class="dim-row">
        <text class="dim-name">{{item.name}}</text>
        <text class="dim-value">{{item.valueText}}</text>
      </view>
    </view>

    <!-- 优势与限制 -->
    <view wx:if="{{strengths.length || limitations.length}}" class="card">
      <text class="card-title">优势与限制</text>
      <view class="pros-cons">
        <view class="pros">
          <text wx:for="{{strengths}}" wx:key="*this" class="pro-item">+ {{item}}</text>
        </view>
        <view class="cons">
          <text wx:for="{{limitations}}" wx:key="*this" class="con-item">− {{item}}</text>
        </view>
      </view>
    </view>

    <!-- 同系列 -->
    <view wx:if="{{familyVariants.length}}" class="card">
      <text class="card-title">{{familyName}}</text>
      <view wx:for="{{familyVariants}}" wx:key="id" class="link-row" data-name="{{item.name}}" bindtap="onFamilyVariantTap">
        <text class="link-main">{{item.displayName}}</text>
        <text class="link-meta">{{item.releaseDate}}<text wx:if="{{item.rankText}}"> · {{item.rankText}}</text></text>
      </view>
      <text wx:if="{{familyPath}}" class="text-link" bindtap="goFamilyPage">查看系列页 →</text>
    </view>

    <!-- 同价位竞品 -->
    <view wx:if="{{peers.length}}" class="card">
      <text class="card-title">同价位竞品</text>
      <view wx:for="{{peers}}" wx:key="name" class="link-row" data-name="{{item.name}}" bindtap="onPeerTap">
        <text class="link-main">{{item.displayName}}</text>
        <text class="link-meta">{{item.provider}} · #{{item.rank}} · {{item.priceText}}</text>
      </view>
    </view>

    <!-- 更多信息（折叠） -->
    <view class="card">
      <view class="more-toggle" bindtap="toggleMore">
        <text class="card-title">更多信息</text>
        <text class="more-caret">{{showMore ? '收起' : '展开'}}</text>
      </view>
      <block wx:if="{{showMore}}">
        <view wx:if="{{companyName}}" class="more-block">
          <text class="more-title">{{companyName}}</text>
          <text class="body">{{companySummary}}</text>
          <text class="section-note">{{companyMeta}}</text>
        </view>
        <view wx:if="{{timeline.length}}" class="more-block">
          <text class="more-title">公开历程</text>
          <view wx:for="{{timeline}}" wx:key="title" class="timeline-row">
            <text class="timeline-date">{{item.date}}</text>
            <text class="timeline-title">{{item.title}}</text>
          </view>
        </view>
        <view class="more-block">
          <text class="more-title">数据来源</text>
          <text class="section-note">排名：LMArena · 数据截至 {{updatedDate}}</text>
          <text wx:if="{{verifiedAt}}" class="section-note">档案：OpenRouter / 官方公开信息 · 核对于 {{verifiedAt}}</text>
          <text class="text-link" bindtap="copySources">复制来源链接</text>
        </view>
      </block>
    </view>

    <view class="page-foot">
      <text class="text-link" bindtap="goHome">看完整排行 →</text>
    </view>

    <view class="action-bar">
      <view class="action-fav {{isFav ? 'action-on' : ''}}" bindtap="toggleFavorite">{{isFav ? '已收藏' : '收藏'}}</view>
      <view class="action-compare {{inCompare ? 'action-on' : ''}}" bindtap="toggleCompare">{{inCompare ? '已在对比' : '加入对比'}}</view>
      <view class="action-primary" bindtap="onGeneratePoster">{{generatingPoster ? '生成中…' : '生成图片'}}</view>
    </view>
  </block>

  <poster id="poster" />
</view>

/* pages/detail/detail.wxss — v1.7 品牌蓝专业版 */
.page { background: #F5F7FA; min-height: 100vh; padding-bottom: 160rpx; }
.center-box { display: flex; flex-direction: column; align-items: center; padding: 200rpx 0; color: #5B6675; font-size: 14px; }
.back-btn { margin-top: 24rpx; padding: 12rpx 40rpx; background: #0F172A; color: #fff; border-radius: 8rpx; font-size: 14px; }

/* Hero */
.hero { background: #0F172A; padding: 30rpx 32rpx 34rpx; color: #FFFFFF; border-bottom: 2rpx solid #C8A24A; }
.hero-kicker { display: block; font-size: 12px; color: rgba(255,255,255,0.75); }
.hero-title { display: block; margin-top: 8rpx; font-size: 26px; line-height: 1.25; font-weight: 700; }
.hero-meta { display: block; margin-top: 10rpx; font-size: 12px; color: rgba(255,255,255,0.72); }
.hero-pending { display: block; margin-top: 12rpx; font-size: 12px; color: rgba(255,255,255,0.82); }

/* 卡片 */
.card { background: #FFFFFF; margin: 20rpx 24rpx; border: 1rpx solid #E5EAF2; border-radius: 12rpx; padding: 24rpx; }
.card-title { display: block; font-size: 16px; line-height: 1.4; font-weight: 600; color: #0F172A; margin-bottom: 12rpx; }
.body { display: block; font-size: 14px; line-height: 1.65; color: #334155; }
.body-meta { display: block; margin-top: 10rpx; font-size: 13px; line-height: 1.7; color: #5B6675; }
.section-note { display: block; margin-top: 10rpx; font-size: 12px; line-height: 1.6; color: #7A8494; }
.text-link { display: inline-block; margin-top: 12rpx; font-size: 13px; color: #0F5EF0; }

/* 核心数据 */
.metrics-card { display: flex; flex-wrap: wrap; padding: 18rpx 24rpx; }
.metric { width: 50%; box-sizing: border-box; padding: 10rpx 12rpx 10rpx 0; }
.metric-label { display: flex; align-items: center; font-size: 11px; color: #7A8494; }
.metric-star { width: 12px; height: 12px; margin-right: 4rpx; }
.metric-value { display: block; margin-top: 2rpx; font-size: 18px; font-weight: 600; color: #0F172A; font-feature-settings: 'tnum'; }
.metric-sub { font-size: 12px; font-weight: 400; color: #7A8494; }
.metric-none { color: #7A8494; }
.price-note { display: block; margin: -8rpx 28rpx 0; font-size: 12px; line-height: 1.6; color: #5B6675; }

/* 规格 */
.spec-row { display: flex; align-items: baseline; padding: 10rpx 0; border-bottom: 1rpx solid #EEF1F6; }
.spec-row:last-of-type { border-bottom: none; }
.spec-label { width: 120rpx; flex-shrink: 0; font-size: 12px; color: #5B6675; }
.spec-value { flex: 1; font-size: 13px; color: #1E293B; word-break: break-all; }
.spec-mono { font-size: 12px; color: #5B6675; }

/* 榜单 */
.rank-row { display: flex; align-items: center; padding: 10rpx 0; border-bottom: 1rpx solid #EEF1F6; }
.rank-row:last-of-type { border-bottom: none; }
.rank-name { flex: 1; font-size: 13px; color: #334155; }
.rank-pos { width: 120rpx; text-align: right; font-size: 13px; font-weight: 600; color: #0F172A; font-feature-settings: 'tnum'; }
.rank-total { font-size: 11px; font-weight: 400; color: #7A8494; }
.rank-pct { width: 96rpx; text-align: right; font-size: 12px; color: #5B6675; font-feature-settings: 'tnum'; }

/* 分维度 */
.dim-row { display: flex; align-items: center; padding: 8rpx 0; }
.dim-name { flex: 1; font-size: 13px; color: #5B6675; }
.dim-value { font-size: 14px; font-weight: 600; color: #0F172A; font-feature-settings: 'tnum'; }

/* 优势/限制 */
.pros-cons { display: flex; flex-wrap: wrap; }
.pros, .cons { width: 50%; box-sizing: border-box; }
.pros { padding-right: 12rpx; }
.cons { padding-left: 12rpx; }
.pro-item, .con-item { display: block; font-size: 13px; line-height: 1.8; }
.pro-item { color: #047857; }
.con-item { color: #B45309; }

/* 链接行 */
.link-row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; border-top: 1rpx solid #EEF1F6; }
.link-main { flex: 1; font-size: 13px; color: #1E293B; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.link-meta { margin-left: 12rpx; font-size: 12px; color: #5B6675; flex-shrink: 0; }

/* 更多 */
.more-toggle { display: flex; align-items: baseline; justify-content: space-between; }
.more-toggle .card-title { margin-bottom: 0; }
.more-caret { font-size: 12px; color: #0F5EF0; }
.more-block { margin-top: 18rpx; padding-top: 14rpx; border-top: 1rpx solid #EEF1F6; }
.more-title { display: block; font-size: 14px; font-weight: 600; color: #0F172A; margin-bottom: 6rpx; }
.timeline-row { display: flex; padding: 8rpx 0; }
.timeline-date { width: 140rpx; flex-shrink: 0; font-size: 12px; color: #5B6675; }
.timeline-title { flex: 1; font-size: 13px; color: #334155; line-height: 1.5; }
.page-foot { margin: 24rpx 0 0; text-align: center; }

/* 底部操作 */
.action-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); background: #FFFFFF; border-top: 1rpx solid #E5EAF2; z-index: 100; }
.action-fav, .action-compare, .action-primary { flex: 1; display: flex; align-items: center; justify-content: center; padding: 18rpx 0; border-radius: 10rpx; font-size: 14px; font-weight: 500; }
.action-icon { width: 17px; height: 17px; margin-right: 6rpx; }
.action-fav, .action-compare { margin-right: 14rpx; border: 1rpx solid #E5EAF2; color: #0F172A; }
.action-compare { color: #0F5EF0; border-color: #BFD0F7; }
.action-primary { background: #0F172A; color: #FFFFFF; font-weight: 600; }
.action-on { background: #EEF3FF; border-color: #BFD0F7; color: #0F5EF0; }

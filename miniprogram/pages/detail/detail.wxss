/* pages/detail/detail.wxss — v1.6 */
.page { background: #F6F7F9; min-height: 100vh; padding-bottom: 180rpx; }
.center-box { display: flex; flex-direction: column; align-items: center; padding: 200rpx 0; color: #5B6675; font-size: 14px; }
.back-btn { margin-top: 24rpx; padding: 12rpx 40rpx; background: #0F5EF0; color: #fff; border-radius: 12rpx; font-size: 14px; }

/* 身份卡 */
.hero { background: #0F172A; padding: 24rpx 32rpx 30rpx; color: #FFFFFF; border-bottom: 2rpx solid #0F5EF0; }
.hero-top { display: flex; align-items: center; justify-content: flex-end; margin-bottom: 16rpx; }
.hero-actions { display: flex; align-items: center; }
.img-btn { margin-right: 14rpx; font-size: 12px; color: rgba(255,255,255,0.78); padding: 7rpx 14rpx; border: 1rpx solid rgba(255,255,255,0.26); border-radius: 10rpx; }
.fav-btn { font-size: 12px; color: rgba(255,255,255,0.65); padding: 7rpx 14rpx; border: 1rpx solid rgba(255,255,255,0.22); border-radius: 10rpx; }
.fav-on { color: #FCD34D; border-color: rgba(252,211,77,0.5); }
.model-name { font-size: 30px; line-height: 1.25; font-weight: 700; display: block; }
.model-sub { margin-top: 8rpx; font-size: 13px; color: rgba(255,255,255,0.7); }
.dot { margin: 0 8rpx; }
.badges { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.badge { margin: 0 10rpx 8rpx 0; padding: 5rpx 14rpx; font-size: 12px; border-radius: 8rpx; background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.88); }
.badge-rank { background: rgba(15,94,240,0.9); color: #FFFFFF; }

.body { padding-top: 4rpx; }

/* 卡片 */
.card { background: #FFFFFF; margin: 20rpx 24rpx; border: 1rpx solid #E4E8EE; border-radius: 16rpx; padding: 28rpx; }
.card-title { display: block; font-size: 17px; line-height: 1.4; font-weight: 600; color: #0F172A; margin-bottom: 14rpx; }
.card-head { display: flex; align-items: baseline; justify-content: space-between; }
.card-aside { font-size: 12px; color: #5B6675; }
.card-note { display: block; font-size: 13px; color: #5B6675; margin: -6rpx 0 12rpx; line-height: 1.6; }

.intro-text { display: block; font-size: 15px; color: #334155; line-height: 1.7; }
.chips { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.chip { margin: 0 10rpx 10rpx 0; padding: 5rpx 14rpx; font-size: 12px; color: #0F5EF0; background: #EEF3FF; border-radius: 8rpx; }

/* 关键数据 */
.quick-card { padding-top: 22rpx; }
.quick-row { display: flex; }
.quick-item { flex: 1; }
.quick-label { display: block; font-size: 12px; color: #5B6675; }
.quick-value { display: block; margin-top: 2rpx; font-size: 18px; font-weight: 600; color: #0F172A; }
.quick-price { margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid #EDF0F4; }
.quick-price-row { display: flex; flex-wrap: wrap; }
.quick-price-value { margin-right: 24rpx; font-size: 15px; font-weight: 600; color: #0F172A; }
.quick-source { display: block; margin-top: 4rpx; font-size: 12px; color: #5B6675; }
.quick-alt { display: block; margin-top: 4rpx; font-size: 12px; color: #5B6675; }
.quick-none { display: block; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid #EDF0F4; font-size: 13px; color: #5B6675; }

/* 规格 */
.spec-grid { display: flex; flex-wrap: wrap; }
.spec { width: 50%; box-sizing: border-box; padding: 10rpx 12rpx 10rpx 0; }
.spec-wide { width: 100%; padding-right: 0; }
.spec-label { display: block; font-size: 12px; color: #5B6675; }
.spec-value { display: block; margin-top: 2rpx; font-size: 14px; color: #0F172A; font-weight: 500; word-break: break-all; }
.spec-mono { font-size: 12px; color: #5B6675; }

/* 通用行 / 链接 */
.link-row { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0 2rpx; border-top: 1rpx solid #EDF0F4; margin-top: 10rpx; font-size: 13px; color: #0F5EF0; }
.link-row:active { opacity: 0.7; }
.model-link { border-top: 1rpx solid #EDF0F4; }
.link-main { flex: 1; font-size: 14px; color: #0F172A; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.link-meta { margin-left: 16rpx; font-size: 12px; color: #5B6675; flex-shrink: 0; }

/* 价格行（保留兼容） */
.price-row { display: flex; align-items: baseline; padding: 10rpx 0; border-bottom: 1rpx solid #EDF0F4; }
.price-row:last-of-type { border-bottom: none; }
.price-label { width: 80rpx; font-size: 13px; color: #5B6675; }
.price-val { font-size: 16px; font-weight: 600; color: #0F172A; }
.price-unit { margin-left: 12rpx; font-size: 12px; color: #5B6675; }
.price-source { display: block; margin-top: 10rpx; font-size: 12px; color: #5B6675; }
.no-data { display: block; text-align: center; padding: 18rpx; font-size: 13px; color: #5B6675; }

/* 榜单表现 */
.rank-row { display: flex; align-items: center; padding: 10rpx 0; }
.rank-name { width: 170rpx; font-size: 13px; color: #334155; }
.rank-bar-wrap { flex: 1; margin: 0 16rpx; }
.rank-bar-bg { height: 6rpx; background: #ECEFF4; border-radius: 3rpx; overflow: hidden; }
.rank-bar-fill { height: 100%; background: #0F5EF0; border-radius: 3rpx; }
.rank-value { width: 110rpx; text-align: right; font-size: 14px; font-weight: 600; color: #0F172A; font-feature-settings: 'tnum'; }
.rank-total { font-size: 11px; font-weight: 400; color: #5B6675; }

/* 分维度 */
.dim-row { display: flex; align-items: center; padding: 8rpx 0; }
.dim-name { width: 120rpx; font-size: 13px; color: #5B6675; }
.dim-bar-wrap { flex: 1; margin: 0 16rpx; }
.dim-bar-bg { height: 6rpx; background: #ECEFF4; border-radius: 3rpx; overflow: hidden; }
.dim-bar-fill { height: 100%; background: #0F5EF0; border-radius: 3rpx; }
.dim-value { width: 80rpx; text-align: right; font-size: 14px; font-weight: 600; color: #0F172A; font-feature-settings: 'tnum'; }

/* 优势与限制 */
.pros-cons { display: flex; flex-wrap: wrap; }
.pros, .cons { width: 50%; box-sizing: border-box; }
.pros { padding-right: 12rpx; }
.cons { padding-left: 12rpx; }
.pro-item, .con-item { display: block; font-size: 13px; line-height: 1.9; }
.pro-item { color: #047857; }
.con-item { color: #B45309; }

/* 时间线 */
.timeline-row { display: flex; padding: 10rpx 0; border-top: 1rpx solid #EDF0F4; }
.timeline-date { width: 150rpx; font-size: 12px; color: #5B6675; flex-shrink: 0; }
.timeline-main { flex: 1; }
.timeline-title { font-size: 13px; color: #334155; line-height: 1.5; }

/* 来源 */
.sources { background: #FBFCFD; }
.source-line { display: block; font-size: 12px; color: #5B6675; line-height: 1.8; }

/* 档案建设中 */
.pending { background: #FFFBEB; border-color: #FDE68A; }
.pending-title { display: block; font-size: 14px; font-weight: 600; color: #92400E; margin-bottom: 6rpx; }
.pending-text { display: block; font-size: 13px; color: #92400E; line-height: 1.6; }

/* 数据更新时间 */
.updated-tip { text-align: center; padding: 16rpx 0 20rpx; font-size: 12px; color: #5B6675; }

/* 底部加入对比栏 */
.compare-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 18rpx 24rpx; padding-bottom: calc(18rpx + env(safe-area-inset-bottom)); display: flex; border-top: 1rpx solid #E4E8EE; z-index: 100; }
.compare-btn { flex: 1; background: #0F5EF0; color: #fff; text-align: center; padding: 20rpx 0; border-radius: 12rpx; font-size: 15px; font-weight: 600; }
.compare-btn-in { background: #047857; }
.compare-go { width: 160rpx; margin-left: 14rpx; text-align: center; padding: 20rpx 0; border: 1rpx solid #0F5EF0; color: #0F5EF0; border-radius: 12rpx; font-size: 14px; font-weight: 600; }
.home-btn { width: 200rpx; margin-left: 14rpx; text-align: center; padding: 20rpx 0; background: #F6F7F9; color: #0F172A; border-radius: 12rpx; font-size: 14px; font-weight: 600; }

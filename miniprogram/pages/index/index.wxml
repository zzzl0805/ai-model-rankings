<!-- pages/index/index.wxml — v1.7 编辑型数据终端 -->
<view class="page">
  <!-- 纸白 masthead -->
  <view class="masthead" style="padding-top:{{statusBarHeight}}px;">
    <view class="masthead-row" style="padding-right:{{menuRight}}px;">
      <text class="wordmark">AI 模型排行</text>
      <text class="masthead-date">{{lastUpdated}}</text>
    </view>
    <text class="masthead-sub" style="padding-right:{{menuRight}}px;">LMArena 人类盲测 · 每日更新</text>
  </view>

  <!-- 一行筛选：榜单 / 搜索 / 视角 -->
  <view class="filter-bar">
    <view class="filter-btn" bindtap="openFilter">
      <image class="filter-icon" src="/assets/icons/icon-filter-gray.png" mode="aspectFit"></image>
      <text>{{activeCategoryName}} · {{activeDimensionName}}</text>
      <view class="caret"></view>
    </view>
    <view class="search-box">
      <icon class="search-icon" type="search" size="14" color="#6E6A60" />
      <input class="search-input" placeholder="搜索模型或厂商" value="{{searchText}}" bindinput="onSearchInput" />
      <text wx:if="{{searchText}}" class="search-clear" bindtap="onSearchClear">✕</text>
    </view>
    <picker range="{{['全部','国产','海外']}}" bindchange="onRegionPick">
      <view class="region-btn"><text>{{regionLabel}}</text><view class="caret"></view></view>
    </picker>
  </view>

  <!-- 今日概览 -->
  <view wx:if="{{overview && !searchText}}" class="overview">
    <view class="ov-head">
      <text class="ov-label">今日概览</text>
      <view class="ov-head-right">
        <text class="ov-sub">{{activeCategoryName}} · {{activeDimensionName}}</text>
        <view class="ov-share" bindtap="onGeneratePoster">
          <image class="ov-share-icon" src="/assets/icons/icon-image-gold.png" mode="aspectFit"></image>
          <text>{{generatingPoster ? '生成中…' : '海报'}}</text>
        </view>
      </view>
    </view>
    <view class="ov-grid">
      <view class="ov-main">
        <text class="ov-label">榜首</text>
        <view class="ov-name-line">
          <image class="ov-crown" src="/assets/icons/icon-star-gold.png" mode="aspectFit"></image>
          <text class="ov-name">{{overview.top.name}}</text>
        </view>
        <text class="ov-value">{{overview.top.value}}<text wx:if="{{overview.top.delta}}" class="ov-delta">{{overview.top.delta}}</text></text>
      </view>
      <view class="ov-item">
        <text class="ov-label">{{overview.up.label}}</text>
        <text class="ov-name">{{overview.up.name}}</text>
        <text class="ov-value">{{overview.up.value}}</text>
      </view>
      <view class="ov-item">
        <text class="ov-label">{{overview.third.label}}</text>
        <text class="ov-name">{{overview.third.name}}</text>
        <text class="ov-value">{{overview.third.value}}</text>
      </view>
    </view>
    <text class="ov-note">{{conclusion}}</text>
  </view>

  <!-- 列头 -->
  <view class="col-head">
    <text class="ch-rank">#</text>
    <text class="ch-model">模型</text>
    <text class="ch-elo">{{searchMode ? '分数' : (isAgent ? '净提升率' : 'Elo')}}</text>
    <text class="ch-price">价格 /M</text>
  </view>

  <view wx:if="{{loading}}" class="center-box"><text>加载中</text></view>
  <view wx:elif="{{displayModels.length===0}}" class="center-box">
    <text>{{searchText ? '没有匹配的模型' : '该维度暂无数据'}}</text>
  </view>

  <view wx:else class="list">
    <view wx:for="{{displayModels}}" wx:key="name" class="row {{!searchMode && item.rank <= 3 ? 'row-top' : ''}}" data-name="{{item.name}}" bindtap="onModelTap">
      <text class="rank">{{item.rankDisplay}}</text>
      <view class="row-main">
        <view class="name-line">
          <text class="model-name">{{item.baseName}}</text>
          <text wx:if="{{item.variant}}" class="variant"> · {{item.variant}}</text>
          <text wx:if="{{item.delta > 0}}" class="delta delta-up">+{{item.delta}}</text>
          <text wx:elif="{{item.delta < 0}}" class="delta delta-down">{{item.delta}}</text>
          <text wx:elif="{{item.isNew}}" class="delta delta-new">新</text>
        </view>
        <text class="row-meta">{{item.provider}}<text wx:if="{{searchMode}}" class="search-cat"> · {{item.categoryName}}</text></text>
      </view>
      <view class="row-right">
        <text class="elo">{{item.eloText}}{{item.isAgent ? '%' : ''}}</text>
        <text wx:if="{{item.price.input > 0}}" class="price">{{item.priceText}}</text>
        <text wx:else class="price price-none">—</text>
      </view>
    </view>
  </view>

  <!-- 更多入口（不再抢首屏） -->
  <view class="actions">
    <text wx:if="{{displayModels.length}}" class="action" bindtap="onGeneratePoster">{{generatingPoster ? '生成中…' : '生成榜单图片'}}</text>
    <text class="action" data-url="/pages/board-coding/board-coding" bindtap="onMoreBoardTap">编程榜</text>
    <text class="action" data-url="/pages/board-cn/board-cn" bindtap="onMoreBoardTap">国产榜</text>
    <text class="action" data-url="/pages/board-image/board-image" bindtap="onMoreBoardTap">画图榜</text>
    <text class="action" data-path="/pages/budget/budget" bindtap="onLandingTap">预算选型</text>
  </view>

  <!-- 脚注 -->
  <view wx:if="{{displayModels.length}}" class="footnote">
    <text class="foot-line">{{ctxNote}}</text>
    <text class="foot-line">统计：名次按 Elo 点估计，CI 重叠不代表差异显著；样本 &lt;1000 仅在详情标注。</text>
    <text class="foot-line">价格：≈ 为汇率折算，「代理」为 OpenRouter 渠道价；以厂商官网为准。</text>
    <text class="foot-line">计分：各榜独立计分，Elo 不可跨榜比较；筛选后名次按当前榜单重排。</text>
  </view>

  <!-- 热门模型/系列（搜索内链） -->
  <view class="landing-links">
    <text class="landing-title">热门模型</text>
    <view class="landing-chips">
      <text wx:for="{{hotLinks}}" wx:key="label" class="landing-chip" data-path="{{item.path}}" bindtap="onLandingTap">{{item.label}}</text>
    </view>
    <text class="landing-title">模型系列</text>
    <view class="landing-chips">
      <text wx:for="{{familyLinks}}" wx:key="label" class="landing-chip" data-path="{{item.path}}" bindtap="onLandingTap">{{item.label}}</text>
    </view>
  </view>

  <poster id="poster" />

  <!-- 榜单选择 sheet -->
  <view wx:if="{{showFilter}}" class="sheet-mask" bindtap="closeFilter">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">选择榜单</text>
        <text class="sheet-done" bindtap="closeFilter">完成</text>
      </view>
      <text class="sheet-label">类目</text>
      <view class="sheet-grid">
        <view wx:for="{{categories}}" wx:key="id" class="sheet-item {{activeCategory===item.id ? 'sheet-on' : ''}}" data-id="{{item.id}}" bindtap="onCategoryChange">{{item.name}}</view>
      </view>
      <text class="sheet-label">维度</text>
      <view class="sheet-grid">
        <view wx:for="{{dimensions}}" wx:key="id" class="sheet-item {{activeDimension===item.id ? 'sheet-on' : ''}}" data-id="{{item.id}}" bindtap="onFilterDimension">{{item.name}}</view>
      </view>
    </view>
  </view>
</view>

/* pages/index/index.wxss — 简洁 / 美观 / 专业
   色板：主色 #2563EB 唯一；文字三级 #0F172A / #64748B / #94A3B8；
   绿色仅用于「云端」状态；价格用中性色，避免与状态色冲突。 */

page {
  --primary: #2563EB;
  --text: #0F172A;
  --text-2: #64748B;
  --text-3: #677489;   /* 对比度 4.5:1，可用于需要阅读的小字 */
  --text-faint: #94A3B8; /* 仅装饰 */
  --line: #F1F5F9;
  --border: #E2E8F0;
  --bg: #F8FAFC;
  background: var(--bg);
}

.page { min-height: 100vh; padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }

/* ============ 头部 ============ */
.header {
  background: #0F172A;
  padding: 14rpx 24rpx 18rpx;
}
.header-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.header-rules {
  font-size: 22rpx;
  color: rgba(255,255,255,0.55);
  padding: 4rpx 0;
}
.header-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.42);
}

/* ============ 首访提示（细线） ============ */
.guide-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--line);
}
.guide-line-text { font-size: 20rpx; color: var(--text-3); }
.guide-line-close { font-size: 26rpx; color: var(--text-3); padding: 0 8rpx; line-height: 1; }

/* ============ 大类 ============ */
.tab-bar {
  background: #FFFFFF;
  white-space: nowrap;
  padding: 0 32rpx 0 12rpx;
  border-bottom: 1rpx solid var(--line);
}
.tab {
  display: inline-block;
  padding: 20rpx 18rpx 16rpx;
  font-size: 28rpx;
  color: var(--text-2);
  border-bottom: 4rpx solid transparent;
}
.tab-active {
  color: var(--text);
  font-weight: 600;
  border-bottom-color: var(--primary);
}

/* ============ 维度 ============ */
.subtab-bar {
  background: #FFFFFF;
  white-space: nowrap;
  padding: 10rpx 48rpx 10rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}
.subtab {
  display: inline-block;
  padding: 6rpx 20rpx;
  margin-right: 6rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--text-2);
}
.subtab-active {
  background: #EFF6FF;
  color: var(--primary);
  font-weight: 500;
}

/* ============ 搜索 + 视角 ============ */
.toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx 8rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 18rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
}
.search-icon { font-size: 26rpx; color: var(--text-3); margin-right: 10rpx; }
.search-input { flex: 1; font-size: 26rpx; color: var(--text); }
.search-clear { font-size: 24rpx; color: var(--text-3); padding-left: 10rpx; }

.segment {
  display: flex;
  align-items: center;
  height: 64rpx;
  background: #EEF2F7;
  border-radius: 12rpx;
  padding: 4rpx;
}
.seg {
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: var(--text-2);
  border-radius: 9rpx;
  line-height: 1.4;
}
.seg-active {
  background: #FFFFFF;
  color: var(--text);
  font-weight: 600;
  box-shadow: 0 1rpx 3rpx rgba(15,23,42,0.08);
}

/* ============ 本榜结论（列表底部） ============ */
.insight {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
}
.insight-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-3);
  margin-bottom: 6rpx;
}
.insight-text {
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.5;
}

/* ============ 列头 ============ */
.col-head {
  display: flex;
  align-items: center;
  margin: 0 24rpx;
  padding: 6rpx 20rpx 10rpx;
  font-size: 22rpx;
  color: var(--text-2);
}
.ch-rank { width: 64rpx; flex-shrink: 0; text-align: center; }
.ch-main { flex: 1; display: flex; justify-content: space-between; }
.ch-price { width: 236rpx; text-align: right; }
.ch-score { width: 150rpx; flex-shrink: 0; text-align: right; white-space: nowrap; }

/* ============ 列表 ============ */
.list {
  margin: 0 24rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
}
.row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid var(--line);
}
.row:last-child { border-bottom: none; }
.row:active { background: #F8FAFC; }

/* 名次 */
.col-rank {
  width: 64rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}
.rank-top { font-weight: 700; font-size: 28rpx; }
.rank-1 { color: #8A5D1B; }
.rank-2 { color: #5B6675; }
.rank-3 { color: #A05A2C; }

/* 主列 */
.col-main { flex: 1; min-width: 0; }
.name-line {
  display: flex;
  align-items: center;
  overflow: hidden;
}
.model-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.variant {
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 1rpx 8rpx;
  font-size: 18rpx;
  color: #5F6E82;
  background: #EEF2F7;
  border-radius: 4rpx;
}
.delta {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 18rpx;
  padding: 1rpx 6rpx;
  border-radius: 4rpx;
}
.delta-up { color: #047857; background: #ECFDF5; }
.delta-down { color: #B91C1C; background: #FEF2F2; }
.delta-new { color: #B45309; background: #FFFBEB; }

.meta-line {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
  white-space: nowrap;
  overflow: hidden;
}
.meta-global { color: var(--text-2); margin-right: 10rpx; }
.meta-provider { color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.meta-sep { margin: 0 8rpx; color: #CBD5E1; }
.meta-left { flex: 1; min-width: 0; display: flex; align-items: center; margin-right: 16rpx; overflow: hidden; }
.price-cell { width: 236rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: flex-end; }
.meta-price { flex: 1; text-align: right; color: #334155; font-variant-numeric: tabular-nums; white-space: nowrap; }

/* 分数列 */
.col-score {
  width: 150rpx;
  flex-shrink: 0;
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.score {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
}
.score-sub {
  font-size: 20rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
  line-height: 1.3;
}

/* ============ 状态 ============ */
.center-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 140rpx 0;
}
.center-text { font-size: 26rpx; color: var(--text-3); }

/* 脚注 */
.footnote {
  padding: 20rpx 32rpx 8rpx;
  font-size: 20rpx;
  color: var(--text-3);
  line-height: 1.6;
}

/* 列头说明入口 */
.ch-info { margin-left: 4rpx; color: var(--text-2); }
/* 搜索图标（原生 icon 组件） */
.search-icon { width: 28rpx; height: 28rpx; margin-right: 10rpx; flex-shrink: 0; }

/* 代理价标记 */
.meta-proxy {
  margin-left: 6rpx;
  padding: 0 6rpx;
  font-size: 18rpx;
  color: var(--text-2);
  background: #EEF2F7;
  border-radius: 4rpx;
  flex-shrink: 0;
}

/* 相邻名次置信区间重叠标记 */
.tie-mark { font-size: 18rpx; color: var(--text-3); font-weight: 400; margin-left: 1rpx; }

/* 首屏常驻口径提示 */
.ctx-note { margin: 0 24rpx 8rpx; font-size: 20rpx; color: var(--text-2); line-height: 1.5; }
/* 代理价标记 */
.meta-proxy { width: 48rpx; margin-left: 6rpx; text-align: center; font-size: 18rpx; color: var(--text-2); background: #EEF2F7; border-radius: 4rpx; flex-shrink: 0; }
.is-hidden { visibility: hidden; }

/* 横滑区右缘渐隐，提示可滑动 */
.tab-wrap { position: relative; }
.tab-fade {
  position: absolute; right: 0; top: 0; bottom: 1rpx; width: 48rpx;
  background: linear-gradient(90deg, rgba(255,255,255,0), #FFFFFF);
  pointer-events: none;
}

/* 价格单元格：代在左、价格在右，保证价格右缘与列头一致 */
.price-cell { justify-content: flex-end; }
.price-cell .meta-proxy { margin-right: 6rpx; margin-left: 0; }
.price-cell .meta-price { flex: 0 1 auto; }

/* 低样本提示 */
.low-sample {
  display: inline;
  margin-left: 2rpx;
  font-size: 16rpx;
  color: #B45309;
  line-height: 1;
}

/* 低样本标签（与规则页 <1000 票一致） */
.sample-low { margin-left: 6rpx; padding: 0 6rpx; font-size: 16rpx; color: #64748B; background: #F1F5F9; border-radius: 4rpx; flex-shrink: 0; }

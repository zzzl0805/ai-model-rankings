/* pages/index/index.wxss — 简洁 / 美观 / 专业
   色板：主色 #2563EB 唯一；文字三级 #0F172A / #64748B / #94A3B8；
   绿色仅用于「云端」状态；价格用中性色，避免与状态色冲突。 */

page {
  --primary: #2563EB;
  --text: #0F172A;
  --text-2: #64748B;
  --text-3: #94A3B8;
  --line: #F1F5F9;
  --border: #E2E8F0;
  --bg: #F8FAFC;
  background: var(--bg);
}

.page { min-height: 100vh; padding-bottom: 160rpx; }

/* ============ 头部 ============ */
.header {
  background: #0F172A;
  padding: 14rpx 24rpx 18rpx;
}
.header-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.header-rules {
  font-size: 22rpx;
  color: rgba(255,255,255,0.55);
  padding: 4rpx 0;
}
.header-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.42);
}

/* ============ 首访提示（细线） ============ */
.guide-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--line);
}
.guide-line-text { font-size: 20rpx; color: var(--text-3); }
.guide-line-close { font-size: 26rpx; color: var(--text-3); padding: 0 8rpx; line-height: 1; }

/* ============ 大类 ============ */
.tab-bar {
  background: #FFFFFF;
  white-space: nowrap;
  padding: 0 32rpx 0 12rpx;
  border-bottom: 1rpx solid var(--line);
}
.tab {
  display: inline-block;
  padding: 20rpx 18rpx 16rpx;
  font-size: 28rpx;
  color: var(--text-2);
  border-bottom: 4rpx solid transparent;
}
.tab-active {
  color: var(--text);
  font-weight: 600;
  border-bottom-color: var(--primary);
}

/* ============ 维度 ============ */
.subtab-bar {
  background: #FFFFFF;
  white-space: nowrap;
  padding: 10rpx 48rpx 10rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}
.subtab {
  display: inline-block;
  padding: 6rpx 20rpx;
  margin-right: 6rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--text-2);
}
.subtab-active {
  background: #EFF6FF;
  color: var(--primary);
  font-weight: 500;
}

/* ============ 搜索 + 视角 ============ */
.toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx 8rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 18rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
}
.search-icon { font-size: 26rpx; color: var(--text-3); margin-right: 10rpx; }
.search-input { flex: 1; font-size: 26rpx; color: var(--text); }
.search-clear { font-size: 24rpx; color: var(--text-3); padding-left: 10rpx; }

.segment {
  display: flex;
  align-items: center;
  height: 64rpx;
  background: #EEF2F7;
  border-radius: 12rpx;
  padding: 4rpx;
}
.seg {
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: var(--text-2);
  border-radius: 9rpx;
  line-height: 1.4;
}
.seg-active {
  background: #FFFFFF;
  color: var(--text);
  font-weight: 600;
  box-shadow: 0 1rpx 3rpx rgba(15,23,42,0.08);
}

/* ============ 本榜结论（列表底部） ============ */
.insight {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
}
.insight-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-3);
  margin-bottom: 6rpx;
}
.insight-text {
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.5;
}

/* ============ 列头 ============ */
.col-head {
  display: flex;
  align-items: center;
  padding: 6rpx 20rpx 10rpx;
  font-size: 20rpx;
  color: var(--text-3);
}
.ch-rank { width: 64rpx; flex-shrink: 0; text-align: center; }
.ch-main { flex: 1; }
.ch-score { width: 150rpx; flex-shrink: 0; text-align: right; }

/* ============ 列表 ============ */
.list {
  margin: 0 24rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
}
.row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid var(--line);
}
.row:last-child { border-bottom: none; }
.row:active { background: #F8FAFC; }

/* 名次 */
.col-rank {
  width: 64rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}
.rank-top { font-weight: 700; font-size: 28rpx; }
.rank-1 { color: #B7791F; }
.rank-2 { color: #64748B; }
.rank-3 { color: #B45309; }

/* 主列 */
.col-main { flex: 1; min-width: 0; }
.name-line {
  display: flex;
  align-items: center;
  overflow: hidden;
}
.model-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.variant {
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 1rpx 8rpx;
  font-size: 18rpx;
  color: var(--text-3);
  background: #F1F5F9;
  border-radius: 4rpx;
}
.delta {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 18rpx;
  padding: 1rpx 6rpx;
  border-radius: 4rpx;
}
.delta-up { color: #047857; background: #ECFDF5; }
.delta-down { color: #B91C1C; background: #FEF2F2; }
.delta-new { color: #B45309; background: #FFFBEB; }

.meta-line {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
  white-space: nowrap;
  overflow: hidden;
}
.meta-global { color: var(--primary); margin-right: 10rpx; }
.meta-provider { color: var(--text-2); }
.meta-sep { margin: 0 8rpx; color: #CBD5E1; }
.meta-price { color: #334155; }

/* 分数列 */
.col-score {
  width: 150rpx;
  flex-shrink: 0;
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.score {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
}
.score-sub {
  font-size: 20rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
  line-height: 1.3;
}

/* ============ 状态 ============ */
.center-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 140rpx 0;
}
.center-text { font-size: 26rpx; color: var(--text-3); }

/* 脚注 */
.footnote {
  padding: 20rpx 32rpx 8rpx;
  font-size: 20rpx;
  color: var(--text-3);
  line-height: 1.6;
}

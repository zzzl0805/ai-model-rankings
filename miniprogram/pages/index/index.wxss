/* pages/index/index.wxss — v1.7 品牌蓝专业版 */
page {
  --blue: #0F5EF0;
  --ink: #0F172A;
  --text-2: #5B6675;
  --text-3: #7A8494;
  --line: #E5EAF2;
  --bg: #F5F7FA;
  background: var(--bg);
  color: var(--ink);
  font-size: 15px;
  line-height: 1.6;
}
.page { min-height: 100vh; padding-bottom: calc(80rpx + env(safe-area-inset-bottom)); }

/* 品牌蓝 masthead */
.masthead { padding: 18rpx 24rpx 18rpx; background: #0F5EF0; color: #FFFFFF; }
.masthead-row { display: flex; align-items: baseline; justify-content: space-between; }
.wordmark { font-size: 22px; line-height: 1.25; font-weight: 600; letter-spacing: 0.5rpx; }
.masthead-date { font-size: 12px; color: rgba(255,255,255,0.72); font-feature-settings: 'tnum'; }
.masthead-sub { display: block; margin-top: 4rpx; font-size: 12px; color: rgba(255,255,255,0.72); }

/* 一行筛选 */
.filter-bar { display: flex; align-items: center; padding: 14rpx 24rpx; background: #FFFFFF; border-bottom: 1rpx solid var(--line); }
.filter-btn { flex-shrink: 0; display: flex; align-items: center; max-width: 210rpx; margin-right: 14rpx; font-size: 13px; color: var(--ink); }
.filter-btn text:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.caret { width: 10rpx; height: 10rpx; margin-left: 8rpx; margin-top: -4rpx; border-right: 2rpx solid #7A8494; border-bottom: 2rpx solid #7A8494; transform: rotate(45deg); }
.search-box { flex: 1; display: flex; align-items: center; height: 34px; padding: 0 12rpx; background: #F5F7FA; border: 1rpx solid var(--line); border-radius: 8rpx; }
.search-icon { width: 14px; height: 14px; margin-right: 8rpx; flex-shrink: 0; }
.search-input { flex: 1; font-size: 13px; color: var(--ink); }
.search-clear { padding-left: 8rpx; font-size: 13px; color: var(--text-3); }
.region-btn { flex-shrink: 0; display: flex; align-items: center; margin-left: 12rpx; font-size: 13px; color: var(--text-2); }

/* 列头 */
.col-head { display: flex; align-items: center; padding: 14rpx 24rpx 8rpx; font-size: 11px; color: var(--text-3); }
.ch-rank { width: 48rpx; flex-shrink: 0; }
.ch-model { flex: 1; }
.ch-elo { width: 92rpx; flex-shrink: 0; text-align: right; }
.ch-price { width: 170rpx; flex-shrink: 0; text-align: right; }

/* 列表卡片 */
.list { margin: 0 24rpx 20rpx; background: #FFFFFF; border: 1rpx solid var(--line); border-radius: 12rpx; overflow: hidden; }
.row { display: flex; align-items: center; padding: 18rpx 20rpx; border-bottom: 1rpx solid var(--line); }
.row:last-child { border-bottom: none; }
.row:active { background: #F5F7FA; }
.rank { width: 48rpx; flex-shrink: 0; font-size: 13px; color: var(--text-3); font-feature-settings: 'tnum'; }
.row-main { flex: 1; min-width: 0; padding-right: 12rpx; }
.name-line { display: flex; align-items: baseline; overflow: hidden; }
.model-name { font-size: 15px; line-height: 1.4; font-weight: 600; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.variant { font-size: 12px; color: var(--text-3); white-space: nowrap; }
.delta { margin-left: 8rpx; font-size: 11px; font-feature-settings: 'tnum'; }
.delta-up { color: #047857; }
.delta-down { color: #B42318; }
.delta-new { color: #B45309; }
.row-meta { display: block; margin-top: 2rpx; font-size: 12px; color: var(--text-3); }
.row-right { width: 262rpx; flex-shrink: 0; text-align: right; }
.elo { display: block; font-size: 16px; line-height: 1.3; font-weight: 600; color: var(--ink); font-feature-settings: 'tnum'; }
.price { display: block; margin-top: 2rpx; font-size: 12px; color: var(--text-2); font-feature-settings: 'tnum'; }
.price-none { color: var(--text-3); }

/* 状态 */
.center-box { padding: 120rpx 24rpx; text-align: center; font-size: 14px; color: var(--text-2); }

/* 结论 */
.insight { margin: 0 24rpx 20rpx; padding: 22rpx 24rpx; background: #FFFFFF; border: 1rpx solid var(--line); border-radius: 12rpx; }
.insight-label { display: block; font-size: 11px; color: var(--text-3); margin-bottom: 6rpx; }
.insight-text { display: block; font-size: 14px; line-height: 1.65; color: var(--ink); }

/* 更多入口 */
.actions { display: flex; flex-wrap: wrap; margin: 0 24rpx 8rpx; padding: 18rpx 0 4rpx; border-top: 1rpx solid var(--line); }
.action { margin: 0 24rpx 12rpx 0; font-size: 13px; color: var(--blue); }
.action:active { opacity: 0.6; }

/* 脚注 */
.footnote { padding: 20rpx 24rpx 0; }
.foot-line { display: block; font-size: 12px; line-height: 1.7; color: var(--text-3); margin-bottom: 4rpx; }

/* 热门模型/系列 */
.landing-links { padding: 24rpx 24rpx 40rpx; }
.landing-title { display: block; margin: 0 0 8rpx; font-size: 11px; color: var(--text-3); }
.landing-chips { display: flex; flex-wrap: wrap; margin-bottom: 16rpx; }
.landing-chip { margin: 0 18rpx 8rpx 0; font-size: 13px; color: var(--blue); }

/* 榜单选择 sheet */
.sheet-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15,23,42,0.35); z-index: 1000; display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #FFFFFF; border-radius: 20rpx 20rpx 0 0; padding: 28rpx 24rpx calc(32rpx + env(safe-area-inset-bottom)); }
.sheet-head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 16rpx; border-bottom: 1rpx solid var(--line); }
.sheet-title { font-size: 18px; font-weight: 600; color: var(--ink); }
.sheet-done { font-size: 13px; color: var(--blue); }
.sheet-label { display: block; margin: 20rpx 0 10rpx; font-size: 11px; color: var(--text-3); }
.sheet-grid { display: flex; flex-wrap: wrap; }
.sheet-item { width: 31%; margin: 0 2% 10rpx 0; padding: 12rpx 0; text-align: center; font-size: 13px; color: var(--text-2); border: 1rpx solid var(--line); border-radius: 8rpx; }
.sheet-item:nth-child(3n) { margin-right: 0; }
.sheet-on { color: var(--blue); border-color: #BFD0F7; background: #EEF3FF; font-weight: 600; }

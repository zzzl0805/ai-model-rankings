/* pages/mine/mine.wxss — 与首页同一套设计语言 */

page {
  --primary: #2563EB;
  --text: #0F172A;
  --text-2: #64748B;
  --text-3: #677489;
  --line: #F1F5F9;
  --border: #E2E8F0;
  --bg: #F8FAFC;
  background: var(--bg);
}

.page { min-height: 100vh; padding-bottom: calc(80rpx + env(safe-area-inset-bottom)); }

/* 头部 */
.header { background: #0F172A; padding: 14rpx 24rpx 18rpx; }
.header-row { display: flex; align-items: baseline; justify-content: space-between; }
.header-left { display: flex; align-items: baseline; }
.back-link { margin-right: 20rpx; font-size: 24rpx; color: rgba(255,255,255,0.65); }
.back-link:active { color: #FFFFFF; }
.header-title { font-size: 36rpx; font-weight: 600; color: #FFFFFF; }
.header-sub { display: block; margin-top: 6rpx; font-size: 20rpx; color: rgba(255,255,255,0.42); }

/* 区块 */
.section { margin: 20rpx 24rpx 0; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; padding: 8rpx 4rpx 14rpx; }
.section-title { font-size: 26rpx; font-weight: 600; color: var(--text); }
.section-hint { font-size: 20rpx; color: var(--text-3); }

/* 空状态 */
.empty { padding: 36rpx 24rpx; background: #FFFFFF; border-radius: 12rpx; }
.empty-text { font-size: 22rpx; color: var(--text-3); line-height: 1.7; }

/* 列表 */
.list { background: #FFFFFF; border-radius: 12rpx; overflow: hidden; }
.row {
  display: flex; align-items: center;
  padding: 22rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}
.row:last-child { border-bottom: none; }
.row:active { background: #F8FAFC; }

.row-main { flex: 1; min-width: 0; }
.name-line { display: flex; align-items: center; }
.model-name {
  font-size: 28rpx; font-weight: 600; color: var(--text);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.meta-line { display: flex; align-items: center; margin-top: 6rpx; font-size: 21rpx; color: var(--text-3); white-space: nowrap; overflow: hidden; }
.meta-provider { color: var(--text-2); overflow: hidden; text-overflow: ellipsis; }
.meta-sep { margin: 0 8rpx; color: #CBD5E1; }
.meta-price { color: #334155; font-variant-numeric: tabular-nums; }
.meta-cat { margin-left: 10rpx; padding: 0 8rpx; font-size: 18rpx; color: #475569; background: #F1F5F9; border-radius: 6rpx; }
.meta-proxy { margin-right: 6rpx; padding: 0 6rpx; font-size: 17rpx; color: #92400E; background: #FEF3C7; border-radius: 5rpx; }
.meta-time { color: var(--text-3); }

.row-side { flex-shrink: 0; text-align: right; margin-left: 16rpx; }
.score { display: block; font-size: 28rpx; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }
.score-sub { display: block; font-size: 19rpx; color: var(--text-3); font-variant-numeric: tabular-nums; }

.row-del { flex-shrink: 0; margin-left: 18rpx; padding: 8rpx 4rpx; font-size: 20rpx; color: var(--text-3); }

/* 变化标记 */
.delta { flex-shrink: 0; margin-left: 8rpx; font-size: 18rpx; padding: 1rpx 6rpx; border-radius: 4rpx; }
.delta-up { color: #047857; background: #ECFDF5; }
.delta-down { color: #B91C1C; background: #FEF2F2; }
.price-up { margin-left: 8rpx; color: #B91C1C; }
.price-down { margin-left: 8rpx; color: #047857; }

/* 底部 */
.footer { padding: 36rpx 24rpx 20rpx; text-align: center; }
.footer-link { font-size: 22rpx; color: var(--primary); }

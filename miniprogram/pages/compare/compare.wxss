/* pages/compare/compare.wxss */
.page { background: #F6F7F9; min-height: 100vh; padding-bottom: 40rpx; }

.center-box { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 0; }
.center-text { font-size: 28rpx; color: #66707C; }
.empty-icon { font-size: 60rpx; margin-bottom: 16rpx; }

.card { background: #fff; margin: 20rpx 24rpx; border-radius: 16rpx; padding: 28rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.card-title { font-size: 30rpx; font-weight: 700; color: #0F172A; margin-bottom: 20rpx; display: block; }

.slot-row { display: flex; gap: 16rpx; }
.slot { flex: 1; min-width: 0; border-radius: 12rpx; padding: 18rpx 14rpx; min-height: 110rpx; }
.slot-filled { background: #F0F4FF; border: 2rpx solid #C7D2FE; display: flex; align-items: center; }
.slot-add { border: 3rpx dashed #E4E8EE; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.slot-add-icon { font-size: 44rpx; color: #0F5EF0; display: block; }
.slot-add-text { font-size: 24rpx; color: #66707C; }

.slot-info { flex: 1; min-width: 0; }
.slot-name { font-size: 12px; line-height: 1.35; font-weight: 600; color: #0F172A; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; white-space: normal; }
.slot-provider { font-size: 22rpx; color: #66707C; display: block; }
.slot-remove { width: 44rpx; height: 44rpx; border-radius: 50%; background: #FEE2E2; display: flex; align-items: center; justify-content: center; margin-left: 12rpx; }
.slot-remove text { font-size: 24rpx; color: #B42318; }

.group-card { padding: 0; overflow: hidden; }
.group-header { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 24rpx; background: #F6F7F9; }
.group-name { font-size: 28rpx; font-weight: 700; color: #0F5EF0; }
.group-arrow { font-size: 24rpx; color: #66707C; }
.table-scroll { width: 100%; }
.tr { display: flex; border-bottom: 1rpx solid #F1F5F9; }
.tr-header { background: #F1F5F9; }
.td { flex: 0 0 200rpx; padding: 16rpx 12rpx; text-align: center; }
.td-label { flex: 0 0 180rpx; padding: 16rpx 20rpx; font-size: 26rpx; color: #5B6675; background: #FAFBFC; text-align: left; }
.td-header text { font-size: 26rpx; font-weight: 700; color: #0F172A; }
.td-best { background: rgba(16,185,129,0.1); }
.td-val { font-size: 28rpx; color: #0F172A; }
.val-best { color: #047857; font-weight: 700; }

/* Picker */
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 1000; display: flex; align-items: flex-end; }
.sheet { width: 100%; height: 70vh; background: #fff; border-radius: 24rpx 24rpx 0 0; display: flex; flex-direction: column; }
.sheet-header { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx 20rpx; border-bottom: 1rpx solid #E4E8EE; }
.sheet-title { font-size: 32rpx; font-weight: 700; color: #0F172A; }
.sheet-close { width: 52rpx; height: 52rpx; border-radius: 50%; background: #F1F5F9; display: flex; align-items: center; justify-content: center; }
.sheet-close text { font-size: 28rpx; color: #5B6675; }
.sheet-search { padding: 16rpx 32rpx; }
.search-input { height: 72rpx; background: #F6F7F9; border-radius: 36rpx; padding: 0 32rpx; font-size: 28rpx; }
/* scroll-view 在 flex 布局里必须给确定高度（height:0 + flex:1 分配剩余空间），
   否则部分机型高度按内容撑开、底部列表被裁掉；padding 移到内层容器保证滚动到底能露出最后一行 */
.sheet-list { flex: 1; height: 0; min-height: 0; }
.sheet-list-inner { padding: 0 24rpx 20rpx; }
.picker-row { display: flex; align-items: center; padding: 24rpx 20rpx; border-radius: 12rpx; margin-bottom: 12rpx; background: #F6F7F9; }
.picker-disabled { opacity: 0.5; }
.picker-info { flex: 1; min-width: 0; }
.picker-name { font-size: 28rpx; color: #0F172A; display: block; }
.picker-provider { font-size: 22rpx; color: #66707C; display: block; }
.picker-added { font-size: 26rpx; color: #047857; margin-left: 16rpx; }
.picker-score { font-size: 32rpx; font-weight: 700; color: #0F5EF0; margin-left: 16rpx; }

/* 保存对比组 */
.save-row { margin: 0 24rpx 20rpx; display: flex; align-items: center; flex-wrap: wrap; }
.save-btn { flex: 1; min-width: 0; text-align: center; padding: 16rpx 12rpx; background: #FFFFFF; border: 1rpx solid #E4E8EE; border-radius: 10rpx; font-size: 12px; color: #0F172A; font-weight: 500; white-space: nowrap; }
.save-btn:active { background: #F6F7F9; }
.poster-btn { margin-left: 16rpx; background: #0F5EF0; border-color: #0F5EF0; color: #FFFFFF; }
.poster-btn:active { background: #0B4BC4; }
.save-hint { width: 100%; margin: 10rpx 0 0; font-size: 12px; color: #5B6675; }

/* ================= v1.6 ================= */
page { background: #F6F7F9; font-size: 14px; }
.masthead { background: #FFFFFF; padding: 28rpx 32rpx 24rpx; border-bottom: 1rpx solid #E4E8EE; }
.masthead-title { display: block; font-size: 20px; line-height: 1.3; font-weight: 600; color: #0F172A; }
.masthead-sub { display: block; margin-top: 4rpx; font-size: 12px; color: #5B6675; }
.center-text { font-size: 13px; color: #5B6675; }
.card { border: 1rpx solid #E4E8EE; border-radius: 16rpx; box-shadow: none; }
.card-title { font-size: 16px; font-weight: 600; color: #0F172A; }
.slot { border-radius: 12rpx; }
.slot-filled { background: #F6F7F9; border: 1rpx solid #E4E8EE; }
.slot-add { border: 1rpx dashed #C9D0DA; }
.slot-add-icon { font-size: 20px; color: #0F5EF0; }
.slot-add-text { font-size: 12px; color: #5B6675; }
.slot-name { font-size: 14px; color: #0F172A; }
.slot-provider { font-size: 12px; color: #5B6675; }
.slot-remove { width: 40rpx; height: 40rpx; background: #F1F3F6; }
.slot-remove text { font-size: 12px; color: #5B6675; }
.group-header { background: #FBFCFD; }
.group-name { font-size: 13px; font-weight: 600; color: #0F172A; }
.group-arrow { font-size: 12px; color: #5B6675; }
.td-label { font-size: 12px; color: #5B6675; background: #FBFCFD; }
.td-header text { font-size: 12px; font-weight: 600; color: #0F172A; }
.td-val { font-size: 13px; color: #0F172A; }
.val-best { color: #047857; font-weight: 600; }
.td-best { background: #F0FDF4; }
.sheet-title { font-size: 16px; color: #0F172A; }
.search-input { font-size: 13px; background: #F6F7F9; }
.picker-row { background: #F6F7F9; }
.picker-name { font-size: 13px; color: #0F172A; }
.picker-provider { font-size: 12px; color: #5B6675; }
.picker-score { font-size: 14px; color: #0F172A; }
.picker-added { font-size: 12px; color: #047857; }
.save-btn { border-color: #E4E8EE; border-radius: 10rpx; font-size: 12px; color: #0F172A; }
.poster-btn { background: #0F5EF0; border-color: #0F5EF0; color: #fff; }
.save-hint { font-size: 12px; color: #5B6675; }

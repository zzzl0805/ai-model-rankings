page { background: #F6F7F9; }
.page { min-height: 100vh; padding-bottom: 60rpx; }
.hero { background: #0F172A; padding: 32rpx 32rpx 30rpx; color: #fff; border-bottom: 2rpx solid #0F5EF0; }
.hero-title { display: block; font-size: 26px; line-height: 1.25; font-weight: 700; }
.hero-sub { display: block; margin-top: 8rpx; font-size: 12px; color: rgba(255,255,255,0.72); }
.hero-desc { display: block; margin-top: 12rpx; font-size: 12px; line-height: 1.7; color: rgba(255,255,255,0.72); }

.card { background: #fff; margin: 20rpx 24rpx; border: 1rpx solid #E4E8EE; border-radius: 16rpx; padding: 28rpx; }
.label { display: block; margin: 18rpx 0 10rpx; font-size: 12px; color: #5B6675; font-weight: 600; }
.label:first-child { margin-top: 0; }
.chips { display: flex; flex-wrap: wrap; }
.chip { margin: 0 10rpx 10rpx 0; padding: 9rpx 18rpx; font-size: 12px; color: #334155; background: #F6F7F9; border: 1rpx solid #E4E8EE; border-radius: 10rpx; }
.chip-on { color: #0F5EF0; background: #EEF3FF; border-color: #C7D7FE; font-weight: 600; }
.budget-input { width: 150rpx; height: 56rpx; padding: 0 14rpx; font-size: 12px; background: #F6F7F9; border: 1rpx solid #E4E8EE; border-radius: 10rpx; }
.hint { display: block; margin-top: 2rpx; font-size: 12px; color: #5B6675; }
.segment { display: flex; background: #F1F3F6; border-radius: 10rpx; padding: 4rpx; }
.seg { flex: 1; text-align: center; padding: 9rpx 0; font-size: 12px; color: #5B6675; border-radius: 8rpx; }
.seg-on { background: #fff; color: #0F172A; font-weight: 600; }

.notice { margin: 20rpx 24rpx 0; padding: 16rpx 20rpx; background: #FFFBEB; border: 1rpx solid #FDE68A; border-radius: 12rpx; font-size: 12px; color: #92400E; line-height: 1.6; }

.results { margin: 20rpx 24rpx 0; }
.section-title { display: block; margin: 8rpx 4rpx 12rpx; font-size: 16px; font-weight: 600; color: #0F172A; }
.result { background: #fff; border: 1rpx solid #E4E8EE; border-radius: 16rpx; padding: 24rpx 26rpx; margin-bottom: 16rpx; }
.result-head { display: flex; align-items: baseline; justify-content: space-between; }
.result-name { flex: 1; font-size: 15px; font-weight: 600; color: #0F172A; }
.result-cost { margin-left: 16rpx; font-size: 15px; font-weight: 700; color: #0F172A; }
.result-meta { margin-top: 6rpx; font-size: 12px; color: #5B6675; }
.result-meta text { margin-right: 4rpx; }
.tag { margin: 10rpx 8rpx 0 0; padding: 4rpx 12rpx; font-size: 12px; color: #0F5EF0; background: #EEF3FF; border-radius: 6rpx; }
.reason { display: block; margin-top: 8rpx; font-size: 12px; color: #5B6675; }

.note { margin: 24rpx 28rpx 0; font-size: 12px; color: #5B6675; line-height: 1.7; }
.note text { display: block; }
.footer-link { margin: 24rpx 0 20rpx; text-align: center; font-size: 13px; color: #0F5EF0; }

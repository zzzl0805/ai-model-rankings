/* pages/methodology/methodology.wxss */
.page { background: #F5F7FA; min-height: 100vh; }
.container { padding: 24rpx; padding-bottom: 60rpx; }

.section { margin-bottom: 32rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: #0F172A; display: block; margin-bottom: 16rpx; }

.card { background: #fff; border-radius: 16rpx; padding: 28rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.card-text { font-size: 26rpx; color: #334155; line-height: 1.7; display: block; margin-bottom: 12rpx; }
.card-tip { font-size: 24rpx; color: #0F5EF0; background: #EFF6FF; padding: 12rpx 16rpx; border-radius: 8rpx; display: block; margin-top: 12rpx; line-height: 1.5; }

.source-row { display: flex; justify-content: space-between; padding: 10rpx 0; border-bottom: 1rpx solid #F1F5F9; }
.source-row:last-child { border-bottom: none; }
.source-label { font-size: 26rpx; color: #5B6675; }
.source-val { font-size: 26rpx; color: #0F172A; font-weight: 500; }

.step { display: flex; align-items: center; padding: 12rpx 0; }
.step-num { width: 40rpx; height: 40rpx; background: #0F5EF0; color: #fff; border-radius: 50%; font-size: 24rpx; display: flex; align-items: center; justify-content: center; margin-right: 16rpx; flex-shrink: 0; }
.step-text { font-size: 26rpx; color: #334155; }

.dim-row { display: flex; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #F5F7FA; }
.dim-row:last-child { border-bottom: none; }
.dim-icon { font-size: 32rpx; margin-right: 12rpx; }
.dim-name { font-size: 26rpx; color: #0F172A; font-weight: 600; min-width: 120rpx; }
.dim-desc { font-size: 24rpx; color: #66707C; }

.conf-row { display: flex; align-items: center; padding: 12rpx 0; }
.conf-dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 12rpx; }
.conf-label { font-size: 26rpx; color: #0F172A; font-weight: 600; min-width: 140rpx; }
.conf-desc { font-size: 24rpx; color: #66707C; }

.price-item { font-size: 24rpx; color: #334155; display: block; padding: 6rpx 0; line-height: 1.6; }

.footer { text-align: center; padding: 32rpx 0; display: flex; flex-direction: column; align-items: center; gap: 20rpx; }
.footer-text { font-size: 22rpx; color: #66707C; }
.feedback-btn { background: #0F5EF0; color: #fff; font-size: 28rpx; border-radius: 40rpx; padding: 16rpx 48rpx; border: none; line-height: 1.5; }
.feedback-btn::after { border: none; }

/* ================= v1.6 ================= */
page { background: #F5F7FA; font-size: 14px; }
.container { padding: 24rpx 24rpx 60rpx; }
.masthead { padding: 8rpx 8rpx 24rpx; }
.masthead-title { display: block; font-size: 20px; line-height: 1.3; font-weight: 600; color: #0F172A; }
.masthead-sub { display: block; margin-top: 4rpx; font-size: 12px; color: #5B6675; }
.section-title { font-size: 16px; color: #0F172A; }
.card { border: 1rpx solid #E4E8EE; border-radius: 16rpx; box-shadow: none; }
.card-text { font-size: 14px; line-height: 1.75; color: #334155; }
.card-tip { font-size: 12px; color: #5B6675; line-height: 1.7; }
.dim-row { padding: 10rpx 0; border-bottom: 1rpx solid #EDF0F4; }
.dim-row:last-child { border-bottom: none; }
.dim-name { font-size: 13px; color: #0F172A; }
.dim-desc { font-size: 12px; color: #5B6675; }
.source-label, .source-val { font-size: 12px; }
.conf-label { font-size: 13px; color: #0F172A; }
.conf-desc { font-size: 12px; color: #5B6675; }
.step-text { font-size: 13px; color: #334155; }
.footnote { font-size: 12px; color: #5B6675; }

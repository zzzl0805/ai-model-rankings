<!-- pages/calculator/calculator.wxml -->
<view class="page">
  <!-- 头部 -->
  <view class="center-header">
    <text class="page-icon">💰</text>
    <text class="page-title">成本计算器</text>
    <text class="page-sub">选择使用场景，估算月度成本</text>
  </view>

  <!-- 场景选择 -->
  <view class="scene-bar">
    <view wx:for="{{scenes}}" wx:key="id"
      class="scene-btn {{activeScene===item.id?'scene-active':''}}"
      data-id="{{item.id}}" bindtap="onSceneTap">
      <text>{{item.name}}</text>
    </view>
  </view>

  <text class="scene-unit">场景与自定义用量单位：万 token / 月（如 200 = 200 万 token）</text>

  <!-- 自定义输入 -->
  <view class="custom-card">
    <text class="custom-label">或自定义月使用量（万token）</text>
    <view class="custom-row">
      <view class="custom-input-wrap">
        <text class="custom-input-label">输入</text>
        <input class="custom-input" type="number" placeholder="如: 200" value="{{customInput}}" bindinput="onCustomInput" />
      </view>
      <view class="custom-input-wrap">
        <text class="custom-input-label">输出</text>
        <input class="custom-input" type="number" placeholder="如: 200" value="{{customOutput}}" bindinput="onCustomOutput" />
      </view>
    </view>
  </view>

  <!-- 排序控制 -->
  <view class="sort-bar">
    <text class="sort-label">排序:</text>
    <view class="sort-btn {{sortBy==='cost'?'sort-active':''}}" data-sort="cost" bindtap="switchSortBy">
      <text>按月费</text>
    </view>
    <view class="sort-btn {{sortBy==='elo'?'sort-active':''}}" data-sort="elo" bindtap="switchSortBy">
      <text>按能力</text>
    </view>
    <view class="sort-order" bindtap="toggleSort">
      <text>{{sortOrder==='asc'?'↑升序':'↓降序'}}</text>
    </view>
  </view>

  <!-- 搜索 -->
  <view class="calc-search-bar">
    <text class="calc-search-icon">🔍</text>
    <input class="calc-search-input" placeholder="搜索模型名称或厂商..." value="{{calcSearch}}" bindinput="onCalcSearch" />
    <text wx:if="{{calcSearch}}" class="calc-search-clear" bindtap="onCalcSearchClear">✕</text>
  </view>

  <!-- 厂商筛选 -->
  <scroll-view scroll-x class="calc-provider-bar">
    <view wx:for="{{providers}}" wx:key="id"
      class="calc-provider-chip {{activeProvider===item.id?'calc-provider-active':''}}"
      data-provider="{{item.id}}" bindtap="onProviderFilter">
      <text>{{item.label}}</text>
    </view>
  </scroll-view>

  <!-- 结果列表 -->
  <view class="result-wrap">
    <view wx:if="{{filteredResults.length===0}}" class="center-box">
      <text class="center-text">{{calcSearch?'未找到匹配的模型':'暂无数据'}}</text>
    </view>

    <view wx:else>
      <view class="result-header">
        <text class="result-title">{{sortBy==='cost'?'月费排行':'能力排行'}}</text>
        <text class="result-count">{{calcSearch ? filteredResults.length + '/' + results.length : results.length}} 个模型</text>
      </view>

      <view wx:for="{{filteredResults}}" wx:key="name" class="result-item"
        data-name="{{item.name}}" bindtap="onResultTap">
        <view class="result-bar" style="width:{{item.barWidth}}%;background:{{sortBy==='cost'?'#EF4444':'#0F5EF0'}};"></view>
        <view class="result-content">
          <view class="result-info">
            <text class="result-name">{{item.displayName}}</text>
            <text class="result-provider">{{item.provider}}</text>
          </view>
          <view class="result-numbers">
            <text class="result-cost">${{item.monthlyCostUSD}}</text>
            <text class="result-cny">≈¥{{item.monthlyCostCNY}}</text>
            <text class="result-elo">Elo: {{item.elo}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- pages/recommend/recommend.wxml -->
<view class="page">
  <view class="header">
    <text class="header-title">🎯 智能推荐</text>
    <text class="header-sub">选场景，秒出最佳模型</text>
  </view>

  <!-- 场景选择 -->
  <view wx:if="{{!selectedScene}}" class="scene-section">
    <text class="section-title">你主要用 AI 做什么？</text>
    <view class="scene-grid">
      <view wx:for="{{scenes}}" wx:key="id" class="scene-card"
        data-id="{{item.id}}" bindtap="onSceneTap">
        <view class="scene-icon-wrap"><text class="scene-icon">{{item.icon}}</text></view>
        <view class="scene-text">
          <text class="scene-name">{{item.name}}</text>
          <text class="scene-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 推荐结果 -->
  <view wx:else>
    <!-- 场景标题 + 推荐理由 -->
    <view class="result-header">
      <view class="result-header-left">
        <text class="result-icon">{{selectedScene.icon}}</text>
        <view>
          <text class="result-title">{{selectedScene.name}}</text>
          <text class="result-reason">💡 {{selectedScene.reason}}</text>
        </view>
      </view>
      <view class="back-btn" bindtap="onBackToScenes"><text>换场景</text></view>
    </view>

    <!-- 数量选择 -->
    <view class="count-bar">
      <view wx:for="{{[3,5,10]}}" wx:key="*this"
        class="count-btn {{maxCount===item?'count-active':''}}"
        data-count="{{item}}" bindtap="onCountChange">
        <text>Top {{item}}</text>
      </view>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="center-box">
      <text class="center-text">推荐中...</text>
    </view>

    <!-- 模型列表 -->
    <view wx:elif="{{recommendedModels.length > 0}}" class="model-list">
      <view wx:for="{{recommendedModels}}" wx:key="rank" class="model-card"
        data-name="{{item.name}}" bindtap="onModelTap">

        <!-- 排名标识 -->
        <view class="rank-area">
          <view wx:if="{{index < 3}}" class="medal medal-{{index}}">
            <text>{{medals[index]}}</text>
          </view>
          <text wx:else class="rank-num">{{index + 1}}</text>
          <text wx:if="{{index === 0}}" class="best-tag">最佳</text>
        </view>

        <!-- 模型信息 -->
        <view class="model-body">
          <view class="model-top">
            <text class="model-name">{{item.displayName}}</text>
            <text class="model-elo">{{item.elo}}{{item.isAgent ? '%' : ''}}</text>
          </view>
          <view class="model-meta">
            <text class="model-provider">{{item.provider}}</text>
            <text class="model-conf" style="color:{{item.confidence.color}};">·{{item.confidence.label}}</text>
            <text wx:if="{{item.votes}}" class="model-votes">·{{item.votes}}{{item.isAgent ? '会话' : '票'}}</text>
          </view>
          <view wx:if="{{item.price.input > 0}}" class="model-price">
            <text class="price-tag">¥{{item.price.inputCNY}}/¥{{item.price.outputCNY}}/百万token</text>
          </view>
          <text wx:elif="{{item.price.input === 0}}" class="model-free">免费</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="action-bar">
        <view class="action-btn compare-action" bindtap="goToCompare">
          <text>📊 前3名加入对比</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:else class="center-box">
      <text class="empty-icon">🤷</text>
      <text class="center-text">暂无该场景的推荐数据</text>
    </view>
  </view>
</view>

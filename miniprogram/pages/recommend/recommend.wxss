/* pages/recommend/recommend.wxss */
.page { background: #F6F7F9; min-height: 100vh; padding-bottom: 40rpx; }

.header { background: #FFFFFF; padding: 28rpx 32rpx 22rpx; color: #0F172A; }
.header-title { font-size: 40rpx; font-weight: 700; display: block; }
.header-sub { font-size: 24rpx; color: rgba(255,255,255,0.7); display: block; margin-top: 4rpx; }

/* 场景选择 */
.scene-section { padding: 24rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: #0F172A; display: block; margin-bottom: 20rpx; }
.scene-grid { display: flex; flex-direction: column; gap: 16rpx; }
.scene-card { display: flex; align-items: center; background: #fff; border-radius: 16rpx; padding: 28rpx 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.scene-icon-wrap { width: 80rpx; height: 80rpx; background: #F0F4FF; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; }
.scene-icon { font-size: 44rpx; }
.scene-text { flex: 1; }
.scene-name { font-size: 30rpx; font-weight: 600; color: #0F172A; display: block; }
.scene-desc { font-size: 24rpx; color: #66707C; display: block; margin-top: 4rpx; }

/* 推荐结果 */
.result-header { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; }
.result-header-left { display: flex; align-items: center; gap: 16rpx; }
.result-icon { font-size: 56rpx; }
.result-title { font-size: 34rpx; font-weight: 700; color: #0F172A; display: block; }
.result-reason { font-size: 24rpx; color: #0F5EF0; display: block; margin-top: 4rpx; }
.back-btn { padding: 12rpx 24rpx; background: #fff; border-radius: 32rpx; font-size: 24rpx; color: #5B6675; border: 1rpx solid #E4E8EE; }

.count-bar { display: flex; gap: 12rpx; padding: 0 24rpx 20rpx; }
.count-btn { padding: 10rpx 28rpx; border-radius: 32rpx; font-size: 24rpx; color: #5B6675; background: #fff; border: 1rpx solid #E4E8EE; }
.count-active { background: #0F5EF0; color: #fff; border-color: #0F5EF0; }

.center-box { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.center-text { font-size: 28rpx; color: #66707C; }
.empty-icon { font-size: 60rpx; margin-bottom: 16rpx; }

/* 模型卡片 */
.model-list { padding: 0 24rpx; }
.model-card { display: flex; align-items: flex-start; background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }

.rank-area { width: 64rpx; display: flex; flex-direction: column; align-items: center; margin-right: 16rpx; }
.medal { width: 52rpx; height: 52rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1); }
.medal-0 { background: transparent; }
.medal-1 { background: transparent; }
.medal-2 { background: transparent; }
.medal text { font-size: 26rpx; }
.rank-num { font-size: 32rpx; font-weight: 700; color: #66707C; }
.best-tag { font-size: 18rpx; color: #B45309; margin-top: 4rpx; }

.model-body { flex: 1; min-width: 0; }
.model-top { display: flex; justify-content: space-between; align-items: baseline; }
.model-name { font-size: 28rpx; font-weight: 600; color: #0F172A; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.model-elo { font-size: 32rpx; font-weight: 700; color: #0F5EF0; }
.model-meta { display: flex; align-items: center; gap: 2rpx; margin-top: 6rpx; }
.model-provider { font-size: 22rpx; color: #66707C; }
.model-conf { font-size: 20rpx; }
.model-votes { font-size: 20rpx; color: #66707C; }
.model-price { margin-top: 8rpx; }
.price-tag { font-size: 24rpx; color: #047857; background: #ECFDF5; padding: 4rpx 12rpx; border-radius: 6rpx; }
.model-free { font-size: 24rpx; color: #047857; display: block; margin-top: 8rpx; }

/* 操作按钮 */
.action-bar { padding: 16rpx 0; }
.action-btn { height: 84rpx; display: flex; align-items: center; justify-content: center; border-radius: 42rpx; font-size: 30rpx; font-weight: 600; }
.compare-action { background: #0F172A; color: #fff; border-radius: 12rpx; font-size: 12px; }

.budget-entry { margin: 20rpx 24rpx 0; padding: 20rpx 24rpx; background: #EFF6FF; color: #0F5EF0; border-radius: 14rpx; font-size: 24rpx; font-weight: 600; }

/* ================= v1.6 ================= */
page { background: #F6F7F9; font-size: 14px; }
.header { background: #FFFFFF; padding: 28rpx 32rpx 22rpx; border-bottom: 1rpx solid #E4E8EE; }
.header-title { font-size: 20px; line-height: 1.3; font-weight: 600; color: #0F172A; }
.header-sub { margin-top: 4rpx; font-size: 12px; color: #5B6675; }
.budget-entry { margin: 20rpx 24rpx 0; padding: 18rpx 22rpx; background: #FFFFFF; color: #0F172A; border: 1rpx solid #E4E8EE; border-radius: 12rpx; font-size: 13px; font-weight: 500; }
.section-title { font-size: 16px; color: #0F172A; }
.scene-card { background: #FFFFFF; border: 1rpx solid #E4E8EE; border-radius: 14rpx; box-shadow: none; }
.scene-name { font-size: 14px; color: #0F172A; }
.scene-desc { font-size: 12px; color: #5B6675; }
.result-title { font-size: 16px; color: #0F172A; }
.result-reason { font-size: 12px; color: #5B6675; }
.count-btn { border-radius: 10rpx; font-size: 12px; color: #5B6675; border-color: #E4E8EE; }
.count-active { background: #EEF3FF; color: #0F5EF0; border-color: #C7D7FE; }
.model-card { background: #FFFFFF; border: 1rpx solid #E4E8EE; border-radius: 14rpx; box-shadow: none; }
.model-name { font-size: 14px; color: #0F172A; }
.model-elo { font-size: 14px; color: #0F172A; font-weight: 600; }
.model-meta, .model-price { font-size: 12px; color: #5B6675; }
.price-tag { font-size: 12px; color: #5B6675; }
.medal { background: transparent; color: #0F172A; font-size: 12px; font-weight: 700; }
.best-tag { background: #EEF3FF; color: #0F5EF0; border-radius: 6rpx; font-size: 12px; }
.rank-num { font-size: 12px; color: #0F172A; }

/* v1.7 */
.page { background: #F5F7FA; }
.scene-card, .model-card { border: 1rpx solid #E5EAF2; border-radius: 12rpx; box-shadow: none; }

/* v1.7 两列场景 */
.scene-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; gap: 0; }
.scene-card { width: 48.5%; box-sizing: border-box; margin-bottom: 14rpx; padding: 22rpx 20rpx; }
.scene-name { font-size: 15px; }
.scene-desc { font-size: 12px; }

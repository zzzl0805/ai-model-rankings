/* app.wxss - Global styles */
page {
  --color-primary: #0F172A;
  --color-secondary: #0F172A;
  --color-accent: #0F5EF0;
  --color-accent-purple: #0F5EF0;
  --color-gold: #0F172A;
  --color-silver: #66707C;
  --color-bronze: #0F172A;
  --color-success: #047857;
  --color-warning: #B45309;
  --color-danger: #B42318;
  --color-bg: #F6F7F9;
  --color-card: #FFFFFF;
  --color-text-primary: #0F172A;
  --color-text-secondary: #5B6675;
  --color-text-tertiary: #66707C;
  --color-divider: #E4E8EE;

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'HarmonyOS Sans', 'Segoe UI', sans-serif;
  font-size: 14px;
  line-height: 1.6;
  color: var(--color-text-primary);
  background-color: var(--color-bg);
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.card {
  background: var(--color-card);
  border: 1rpx solid var(--color-divider);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: none;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.text-primary { color: var(--color-text-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-accent { color: var(--color-accent); }
.text-gold { color: var(--color-gold); }
.text-success { color: var(--color-success); }
.text-danger { color: var(--color-danger); }

.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 40rpx; }

.font-bold { font-weight: 700; }
.font-medium { font-weight: 500; }

.mt-12 { margin-top: 12rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mr-12 { margin-right: 12rpx; }
.ml-12 { margin-left: 12rpx; }

/* Scrollable chip bar */
.chip-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  padding: 16rpx 0;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 22rpx;
  border-radius: 12rpx;
  font-size: 12px;
  background: var(--color-card);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-divider);
  margin-right: 16rpx;
  transition: all 0.2s;
}

.chip.active {
  background: #EEF3FF;
  color: var(--color-accent);
  border-color: #C7D7FE;
}

/* Loading skeleton */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 8rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

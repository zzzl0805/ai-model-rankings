/* components/board/board.wxss */
.board { background: #FFFFFF; border-radius: 20rpx; margin: 0 24rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06); }
.board-meta { padding: 20rpx 28rpx; font-size: 22rpx; color: #94A3B8; background: #F8FAFC; border-bottom: 1rpx solid #F1F5F9; }
.board-empty { padding: 80rpx 0; text-align: center; font-size: 26rpx; color: #94A3B8; }

.board-row { display: flex; align-items: center; padding: 22rpx 28rpx; border-bottom: 1rpx solid #F1F5F9; }
.board-row:last-child { border-bottom: none; }
.board-row:active { background: #F8FAFC; }

.col-rank { width: 56rpx; font-size: 30rpx; font-weight: 700; color: #64748B; font-style: italic; }
.rank-top { color: #0F5EF0; }
.col-main { flex: 1; min-width: 0; }
.row-name { display: block; font-size: 30rpx; font-weight: 600; color: #0F172A; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.row-sub { margin-top: 6rpx; display: flex; align-items: center; }
.row-provider { font-size: 22rpx; color: #64748B; }
.row-proxy { margin-left: 10rpx; padding: 0 8rpx; font-size: 18rpx; color: #92400E; background: #FEF3C7; border-radius: 6rpx; }
.row-price { margin-left: 14rpx; font-size: 22rpx; color: #475569; }
.row-price-none { color: #CBD5E1; }
.col-elo { margin-left: 16rpx; font-size: 32rpx; font-weight: 700; color: #0F5EF0; }
